# Optional SQLAlchemy URL. Leave blank for local SQLite at ./hrms.db.
# To connect a host-run app to the Compose PostgreSQL service, use:
# postgresql+psycopg2://postgres:<POSTGRES_PASSWORD>@localhost:5432/hrms
DATABASE_URL=

# PostgreSQL container (required when using docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=hrms
POSTGRES_PORT=5432

# pgAdmin container (required when using docker compose)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# AI and retrieval integrations
GEMINI_API_KEY=
GROQ_API_KEY=
PINECONE_API_KEY=

# SMTP email notifications
SENDER_EMAIL=
SENDER_PASSWORD=
